---
import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import ExternalLink from '../../components/ExternalLink.astro';
import { site } from '../../site.config';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { title, description, tools, links, thumbImage, thumbAlt } = project.data;
const { Content } = await render(project);

// Single fixed rendition for social crawlers, distinct from the card's responsive srcset
const ogImage = await getImage({ src: thumbImage, width: 1200 });
---

<Layout
  title={`${title} - ${site.name}`}
  description={description}
  image={ogImage.src}
  imageWidth={ogImage.attributes.width}
  imageHeight={ogImage.attributes.height}
  imageAlt={thumbAlt}
>
  <Navbar active="Projects" />

  <!-- aria-labelledby gives this section an accessible name, which promotes it
       to a region landmark. Without it the title, the back link and the project
       links sat outside every landmark, so anyone navigating by landmark went
       straight from the header into the body copy and never met them. The hero
       cannot simply move inside <main> instead: it is full-bleed while <main>
       is a 760px column, and the min-h below is measured to exclude it. -->
  <section
    class="page-hero bg-primary border-b border-divider-strong"
    aria-labelledby="project-title"
  >
    <div class="max-w-[760px] mx-auto px-6 lg:px-0 pt-7 pb-8 lg:pt-11 lg:pb-10">
      <a href="/" data-back-link class="text-detail font-medium text-inverse-soft no-underline">&larr; All projects</a>

      <h1
        id="project-title"
        class="mt-4 mb-2 text-title lg:text-title-lg font-semibold text-inverse [text-wrap:balance]"
      >
        {title}
      </h1>
      <p class="mb-5 text-body leading-[1.55] font-medium text-inverse-soft">{description}</p>

      <div class="flex flex-wrap items-center gap-x-[18px] gap-y-[10px]">
        <div class="flex flex-wrap gap-[5px] lg:gap-[6px]">
          {
            tools.map((tool) => (
              <span class="text-tag font-medium text-inverse-soft bg-primary-raised border border-edge-inverse rounded-[3px] px-[7px] py-[2px] lg:px-2 lg:py-[3px]">
                {tool}
              </span>
            ))
          }
        </div>
        {
          links.map((link) => (
            <ExternalLink
              href={link.url}
              label={link.label}
              class="flex items-center gap-[5px] text-xs font-medium text-accent no-underline"
            />
          ))
        }
      </div>
    </div>
  </section>

  <div class="lg:flex lg:justify-center">
    <!-- mx-auto, not just the lg:justify-center above: between 760px and the
         desktop breakpoint (landscape phones) the column would otherwise sit
         hard left while the hero centred, so the two disagreed -->
    <div class="w-full max-w-[760px] mx-auto min-w-0 flex flex-col min-h-[60svh]">
      <main id="main" tabindex="-1" class="flex-1 px-6 pt-8 pb-4 lg:px-0 lg:pt-10 scroll-mt-[56px] lg:scroll-mt-[var(--nav-h)]">
        <article class="text-body leading-[1.65] font-medium text-muted [&_h2]:text-foreground [&_h2]:text-base [&_h2]:font-semibold [&_h2]:mt-8 [&_h2]:mb-3 [&_p]:mb-4 [&_a]:text-link">
          <Content />
        </article>
      </main>

      <Footer inset={false} />
    </div>
  </div>
</Layout>
