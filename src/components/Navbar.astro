---
import { site } from '../site.config';

const { active = 'About' } = Astro.props;
const items = [
  { label: 'About', href: '/' },
  { label: 'Projects', href: '/#projects' },
];

const speculationRules = {
  prerender: [
    {
      source: 'document',
      where: {
        and: [
          { href_matches: '/*' },
          { not: { href_matches: ['/404', '/500'] } },
          { not: { selector_matches: '[target=_blank]' } },
          { not: { selector_matches: '[rel~=external]' } },
        ],
      },
      eagerness: 'moderate',
    },
  ],
};
---

<header
  transition:persist
  transition:name="header"
  class="sticky top-0 z-20 flex items-center justify-between bg-primary border-b-2 border-edge-inverse
         pt-(--safe-top) h-[calc(3.5rem+var(--safe-top))] min-h-14
         max-lg:pl-[max(22px,env(safe-area-inset-left))] max-lg:pr-[max(22px,env(safe-area-inset-right))]
         lg:bg-page lg:border-divider-strong lg:px-12 lg:h-[calc(var(--nav-h)+var(--safe-top))] lg:min-h-(--nav-h)"
>
  <a href="/" class="text-logo font-semibold text-inverse lg:text-foreground no-underline">
    {site.name}
  </a>
  <nav class="hidden lg:flex gap-[34px] text-sm" aria-label="Primary">
    {
      items.map((item) =>
        item.label === active ? (
          <a href={item.href} class="text-foreground font-medium no-underline" aria-current="page">
            {item.label}
          </a>
        ) : (
          <a href={item.href} class="text-faint font-medium no-underline">
            {item.label}
          </a>
        )
      )
    }
  </nav>

  <!-- Native popover: the browser wires up open/close, Escape, light-dismiss
       and the expanded state — no JavaScript involved -->
  <button type="button" popovertarget="mobile-menu" class="lg:hidden cursor-pointer text-nav font-semibold text-inverse-soft">
    Menu
  </button>
</header>

<!-- Chromium speculation rules: prerender a link's destination on
     hover/touch. Other browsers ignore the unknown script type. -->
<script type="speculationrules" is:inline set:html={JSON.stringify(speculationRules)} />

<nav
  popover
  id="mobile-menu"
  aria-label="Primary"
  class="mobile-menu fixed inset-x-0 top-[calc(3.5rem+var(--safe-top))] bottom-auto m-0 w-full border-0 border-b-2 border-edge-inverse
         bg-primary pl-[max(22px,env(safe-area-inset-left))] pr-[max(22px,env(safe-area-inset-right))] py-2 lg:hidden"
>
  {
    items.map((item) =>
      item.label === active ? (
        <a
          href={item.href}
          class="block py-3 text-body font-semibold text-inverse no-underline border-b border-edge-inverse last:border-b-0"
          aria-current="page"
        >
          {item.label}
        </a>
      ) : (
        <a
          href={item.href}
          class="block py-3 text-body font-medium text-inverse-soft no-underline border-b border-edge-inverse last:border-b-0"
        >
          {item.label}
        </a>
      )
    )
  }
</nav>

<style>
  /* Leave the header strip undimmed. Safari tints its toolbar from the
     sticky header's own background-color, and a translucent overlay
     sitting on top of the header does not change that colour — so the
     page would darken while the toolbar stayed bright green. The header
     darkens itself instead, below. */
  #mobile-menu::backdrop {
    background: linear-gradient(
      to bottom,
      transparent 0 calc(3.5rem + var(--safe-top, 0px)),
      rgb(43 47 40 / 35%) calc(3.5rem + var(--safe-top, 0px))
    );
  }

  /* #484c3d composited under the backdrop's 35% rgb(43 47 40) comes out at
     #3e4236. Applying that as a real background-color keeps the header
     matching the dimmed page while giving Safari a solid colour to sample. */
  header:has(~ #mobile-menu:popover-open) {
    background-color: #3e4236;
  }
</style>
