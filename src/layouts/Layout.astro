---
import '../styles/global.css';
import { ClientRouter, fade } from 'astro:transitions';
import { site } from '../site.config';
import instrumentSansWoff2 from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageAlt?: string;
}

const {
  title = `${site.name} — ${site.role}`,
  description = site.description,
  image = '/og-image.png',
  imageWidth = 1200,
  imageHeight = 630,
  imageAlt = `${site.name} — ${site.role}`,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  url: new URL('/', Astro.site).toString(),
  image: new URL('/og-image.png', Astro.site).toString(),
  sameAs: [site.links.linkedin, site.links.github],
};
---

<!doctype html>
<!-- Home <-> project pages differ a lot in shape (card grid vs. article), so the
     default crossfade duration leaves old/new content visibly overlapping.
     Kept shorter still because landing at the top of a new page makes iOS
     Safari reveal its bottom bar: the snapshots are captured against the
     taller toolbar-hidden viewport and then painted while the viewport
     shrinks under them, so the less time that overlay is on screen the
     less of that mismatch shows. -->
<html lang="en" transition:animate={fade({ duration: '0.08s' })}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta http-equiv="x-ua-compatible" content="ie=edge" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Same value on every page, but without transition:persist the
         router still tears this down and recreates it on each swap —
         iOS Safari's status-bar tint reacts to that removal and briefly
         flashes back to its default before the new tag reapplies it -->
    <meta name="theme-color" content="#484c3d" transition:persist />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Preload the primary font subset so it fetches in parallel with the
         stylesheet instead of being discovered only after the CSS parses -->
    <link rel="preload" href={instrumentSansWoff2} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en_GB" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />

    <ClientRouter />
  </head>
  <body class="bg-page font-sans text-foreground antialiased">
    <!-- Hidden until keyboard-focused; then a full-width bar that pushes the
         page down rather than overlapping the navbar -->
    <a
      href="#main"
      class="skip-link sr-only focus:not-sr-only focus:block focus:w-full
             focus:bg-primary focus:text-inverse focus:text-center focus:px-4 focus:py-3
             text-nav font-medium no-underline"
    >
      Skip to main content
    </a>

    <slot />

    <!-- astro:after-swap only fires on client-side transitions, never on the
         initial load, so this can't steal focus from a first-time visitor -->
    <script>
      // html has scroll-behavior: smooth for in-page anchors (skip link,
      // #projects). The router restores scroll position on back/forward
      // navigation via a plain scrollTo(x, y) call with no explicit
      // behavior, which — unlike a real hard back-navigation — inherits
      // that smooth CSS and visibly animates into place instead of
      // snapping instantly. Toggling scroll-behavior around the swap
      // doesn't survive it (Astro resets the html element's attributes
      // as part of swapping), so force instant at the call site instead;
      // anchor-fragment scrolling never goes through window.scrollTo, so
      // it's unaffected.
      const nativeScrollTo = window.scrollTo.bind(window);
      window.scrollTo = ((x?: number | any, y?: number) => {
        if (typeof x === 'object') {
          return nativeScrollTo(x.behavior ? x : { ...x, behavior: 'instant' });
        }
        return nativeScrollTo({ left: x, top: y, behavior: 'instant' });
      }) as typeof window.scrollTo;

      // "All projects" / "Back to the homepage" are plain <a href="/"> links,
      // not history navigation — so they've never restored scroll position,
      // in this router or a browser's native back/forward. Once we know
      // we're mid-session in client-routed navigation (i.e. this isn't the
      // page's first load), treat data-back-link clicks as a real back-nav
      // instead, so the existing scroll restoration above actually applies.
      // A direct/shared link to a project page skips this (no prior
      // history), and the link just behaves normally.
      // The header is transition:persist'd (see Navbar.astro — Safari 26+
      // colors the status bar from a sticky element's own CSS background,
      // sampled at render time, and doesn't reliably redo that during a
      // client-side swap; persisting keeps that element from ever being
      // torn down and rebuilt mid-transition). Since persisting freezes
      // its DOM, the desktop "About"/"Projects" highlight needs updating
      // by hand instead of by re-render.
      function syncNavActive() {
        const isProjects = location.pathname.startsWith('/projects/');
        document.querySelectorAll('header nav[aria-label="Primary"] a').forEach((a) => {
          const isActive = a.getAttribute('href') === (isProjects ? '/#projects' : '/');
          a.classList.toggle('text-foreground', isActive);
          a.classList.toggle('text-faint', !isActive);
          if (isActive) a.setAttribute('aria-current', 'page');
          else a.removeAttribute('aria-current');
        });
      }

      let cameViaRouter = false;
      document.addEventListener('astro:after-swap', () => {
        cameViaRouter = true;
        syncNavActive();
        // Move focus to the new page's content so it is announced, the way
        // a real navigation would. preventScroll keeps it from dragging
        // the viewport down to #main, which sits below the hero on project
        // pages. Deliberately no capture-and-restore of scrollY around
        // this: the router's own restoration is not always settled by the
        // time this fires, so re-asserting a position here can pin the
        // page to a half-restored offset instead of protecting it.
        document.getElementById('main')?.focus({ preventScroll: true });
      });

      document.addEventListener('click', (event) => {
        const target = event.target as HTMLElement;
        if (cameViaRouter && target.closest('[data-back-link]')) {
          event.preventDefault();
          history.back();
        }
      });
    </script>
  </body>
</html>
