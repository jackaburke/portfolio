---
import '../styles/global.css';
import { ClientRouter, fade } from 'astro:transitions';
import { site } from '../site.config';
import instrumentSansWoff2 from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageAlt?: string;
}

const {
  title = `${site.name} - ${site.role}`,
  description = site.description,
  image = '/og-image.png',
  imageWidth = 1200,
  imageHeight = 630,
  imageAlt = `${site.name} - ${site.role}`,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  url: new URL('/', Astro.site).toString(),
  image: new URL('/og-image.png', Astro.site).toString(),
  sameAs: [site.links.linkedin, site.links.github],
};
---

<!doctype html>
<!-- Short fade: the pages differ a lot in shape, so a longer crossfade shows
     old/new content overlapping. Touch devices skip the fade entirely
     (see global.css) because Safari's URL bar resizes the viewport on
     navigation, which makes any transition overlay visibly jump. -->
<html lang="en" transition:animate={fade({ duration: '0.08s' })}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta http-equiv="x-ua-compatible" content="ie=edge" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Persisted so iOS Safari's status-bar tint doesn't flash back to its
         default when the router recreates the tag on each swap -->
    <meta name="theme-color" content="#484c3d" transition:persist />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Preload the primary font subset so it fetches in parallel with the
         stylesheet instead of being discovered only after the CSS parses -->
    <link rel="preload" href={instrumentSansWoff2} as="font" type="font/woff2" crossorigin />

    <!-- font-display: optional. On a hard load the text either paints in
         this font or stays on the fallback; it never swaps mid-view -->
    <style
      is:inline
      set:html={`@font-face {
  font-family: 'Instrument Sans Variable';
  font-style: normal;
  font-display: optional;
  font-weight: 400 700;
  src: url(${instrumentSansWoff2}) format('woff2-variations');
  unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;
}`}
    />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en_GB" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />

    <!-- Touch devices skip the View Transition API: its snapshots freeze
         the page while Safari's chrome resizes the viewport. Without it the
         router falls back to a plain instant swap. -->
    <script is:inline>
      if (matchMedia('(hover: none)').matches) document.startViewTransition = undefined;
    </script>

    <ClientRouter fallback="swap" />
  </head>
  <body class="font-sans text-foreground antialiased">
    <!-- Hidden until keyboard-focused; then a full-width bar that pushes the
         page down rather than overlapping the navbar -->
    <a
      href="#main"
      class="skip-link sr-only focus:not-sr-only focus:block focus:w-full
             focus:bg-primary focus:text-inverse focus:text-center focus:px-4 focus:py-3
             text-nav font-medium no-underline"
    >
      Skip to main content
    </a>

    <slot />

    <!-- astro:after-swap only fires on client-side transitions, never on the
         initial load, so this can't steal focus from a first-time visitor -->
    <script>
      // The router's scroll restoration would inherit the smooth
      // scroll-behavior meant for in-page anchors, so force instant here.
      // On touch, land at 1px instead of 0: reaching absolute top makes
      // Safari re-expand its collapsed toolbars.
      const touch = matchMedia('(hover: none)').matches;
      const nativeScrollTo = window.scrollTo.bind(window);
      window.scrollTo = ((x?: number | any, y?: number) => {
        if (typeof x === 'object') {
          const opts = x.behavior ? x : { ...x, behavior: 'instant' };
          if (touch && opts.top === 0) opts.top = 1;
          return nativeScrollTo(opts);
        }
        return nativeScrollTo({ left: x, top: touch && y === 0 ? 1 : y, behavior: 'instant' });
      }) as typeof window.scrollTo;

      // The header is transition:persist'd, which freezes its DOM, so the
      // desktop About/Projects highlight is updated by hand on each swap.
      function syncNavActive() {
        const isProjects = location.pathname.startsWith('/projects/');
        document.querySelectorAll('header nav[aria-label="Primary"] a').forEach((a) => {
          const isActive = a.getAttribute('href') === (isProjects ? '/#projects' : '/');
          a.classList.toggle('text-foreground', isActive);
          a.classList.toggle('text-faint', !isActive);
          if (isActive) a.setAttribute('aria-current', 'page');
          else a.removeAttribute('aria-current');
        });
      }

      let cameViaRouter = false;
      document.addEventListener('astro:after-swap', () => {
        cameViaRouter = true;
        syncNavActive();
        // WebKit can stop drawing a classic scrollbar once the router swaps
        // <body>; toggling overflow makes it rebuild before the page paints.
        const html = document.documentElement;
        html.style.overflowY = 'hidden';
        void html.offsetWidth;
        html.style.overflowY = '';
        // Focus the new page's content so it is announced, like a real
        // navigation; preventScroll keeps the viewport where it is.
        // Prefer the h1: on a case study it sits in the hero, above <main>, so
        // focusing <main> would start the reading order below the page title
        // and the visitor would never hear which project they had opened.
        const target = document.querySelector<HTMLElement>('h1') ?? document.getElementById('main');
        if (target && !target.hasAttribute('tabindex')) target.setAttribute('tabindex', '-1');
        target?.focus({ preventScroll: true });
      });

      document.addEventListener('click', (event) => {
        const target = event.target as HTMLElement;
        if (cameViaRouter && target.closest('[data-back-link]')) {
          event.preventDefault();
          history.back();
        }
      });

      // A popover is not modal, so Tab walks straight out of the open menu and
      // on into the page behind it, which the backdrop has dimmed. Close it on
      // the way out: that is the disclosure-menu behaviour a keyboard user
      // expects, and it keeps the dimming honest about what is reachable.
      // relatedTarget is null when the whole window loses focus, which should
      // leave the menu alone.
      document.addEventListener('focusout', (event) => {
        const menu = document.getElementById('mobile-menu');
        if (!menu?.matches(':popover-open')) return;
        const next = (event as FocusEvent).relatedTarget as HTMLElement | null;
        if (!next) return;
        if (menu.contains(next) || next.closest('[popovertarget="mobile-menu"]')) return;
        menu.hidePopover();
      });

      // Cached thumbnails (the common case) are left alone entirely: no
      // opacity, no compositing layer, nothing to flash. Only images still
      // loading get the fade class.
      document.addEventListener('astro:page-load', () => {
        document.querySelectorAll<HTMLImageElement>('.thumb').forEach((img) => {
          if (img.complete) return;
          img.classList.add('fade-in');
          img.addEventListener('load', () => img.classList.add('is-loaded'), { once: true });
        });
      });
    </script>
  </body>
</html>
